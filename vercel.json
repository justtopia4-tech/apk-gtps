{
  "version": 2,
  "rewrites": [
    {
      "source": "/growtopia/server_data.php",
      "destination": "/api/server_data"
    },
    {
      "source": "/server_data.php",
      "destination": "/api/server_data"
    },
    {
      "source": "/raw",
      "destination": "/api/hosts"
    },
    {
      "source": "/raw/(.*)",
      "destination": "/api/hosts"
    },
    {
      "source": "/hosts.txt",
      "destination": "/api/hosts"
    },
    {
      "source": "/how-to-play",
      "destination": "/index.html"
    },
    {
      "source": "/how-to-play/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/login/$1"
    },
    {
      "source": "/panel",
      "destination": "/panel/index.html"
    },
    {
      "source": "/panel/(.*)",
      "destination": "/panel/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
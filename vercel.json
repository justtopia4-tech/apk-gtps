{
  "version": 2,
  "rewrites": [
    {
      "source": "/growtopia/server_data.php",
      "destination": "/api/server_data"
    },
    {
      "source": "/server_data.php",
      "destination": "/api/server_data"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/login/$1"
    },
    {
      "source": "/panel",
      "destination": "/panel/index.html"
    },
    {
      "source": "/panel/(.*)",
      "destination": "/panel/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/:endpoint",
      "destination": "/api/server_data?endpoint=:endpoint"
    }
  ]
}
